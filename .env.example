# 智慧树账号
ZHIHUISHU_USERNAME=你的手机号
ZHIHUISHU_PASSWORD="你的密码"
COURSE_NAME="你要学习的课程完整名称"

# 大模型 API（OpenAI 兼容）
DEEPSEEK_API_KEY="sk-你的密钥"
DEEPSEEK_BASE_URL="https://api.deepseek.com/v1"
ANSWER_MODEL="deepseek-flash"

# 功能开关
ENABLE_LLM_ANSWER=true
ENABLE_REASONING=false

# 浏览器（auto / chrome / msedge / chromium）
# 视频为 H.264 编码，请使用 Chrome 或 Edge，否则会出现“视频无法播放”
BROWSER_CHANNEL=auto
WINDOW_WIDTH=1600
WINDOW_HEIGHT=860
HEADLESS=false
